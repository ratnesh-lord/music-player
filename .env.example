# Unpaused needs no secrets to build or run. Everything here is optional.

# --- Android: sign a release build locally (CI uses repository secrets instead, see docs/DEPLOYMENT.md)
UNPAUSED_KEYSTORE_PATH=/absolute/path/to/unpaused-release.jks
UNPAUSED_KEYSTORE_PASSWORD=
UNPAUSED_KEY_ALIAS=unpaused
UNPAUSED_KEY_PASSWORD=

# --- Web: sub-path the app is served from (GitHub Pages sets /<repo>/). Default "/".
BASE_PATH=/

# --- Web end-to-end tests: reuse an existing Chromium instead of `npx playwright install`.
PW_CHROMIUM=

# Supabase URL and publishable key are entered in the apps at runtime and stored on the device,
# so they are not build variables. Never put a service_role / sb_secret_ key anywhere in this repo.
