{
  "description": "ReplayGain.fromTags + ReplayGain.decide. Expected totalDb/boostDb are rounded to 0.01 dB; attenuation to 4 decimals.",
  "cases": [
    { "name": "track gain, no clipping risk", "tags": { "REPLAYGAIN_TRACK_GAIN": "-6.48 dB", "REPLAYGAIN_TRACK_PEAK": "0.988", "REPLAYGAIN_ALBUM_GAIN": "-7.10 dB", "REPLAYGAIN_ALBUM_PEAK": "1.0" },
      "settings": { "mode": "TRACK", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -6.48, "attenuation": 0.4742, "boostDb": 0, "source": "TRACK" } },
    { "name": "album mode prefers album gain", "tags": { "replaygain_track_gain": "-6.48 dB", "replaygain_album_gain": "-7.10 dB" },
      "settings": { "mode": "ALBUM", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -7.1, "attenuation": 0.4416, "boostDb": 0, "source": "ALBUM" } },
    { "name": "album mode falls back to track gain", "tags": { "REPLAYGAIN_TRACK_GAIN": "-3 dB" },
      "settings": { "mode": "ALBUM", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -3.0, "attenuation": 0.7079, "boostDb": 0, "source": "TRACK" } },
    { "name": "positive gain is capped by the peak", "tags": { "REPLAYGAIN_TRACK_GAIN": "+5.20 dB", "REPLAYGAIN_TRACK_PEAK": "0.8" },
      "settings": { "mode": "TRACK", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": 1.94, "attenuation": 1.0, "boostDb": 1.94, "source": "TRACK" } },
    { "name": "positive gain without clipping guard", "tags": { "REPLAYGAIN_TRACK_GAIN": "+5.20 dB", "REPLAYGAIN_TRACK_PEAK": "0.8" },
      "settings": { "mode": "TRACK", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": false },
      "expect": { "totalDb": 5.2, "attenuation": 1.0, "boostDb": 5.2, "source": "TRACK" } },
    { "name": "preamp is added", "tags": { "REPLAYGAIN_TRACK_GAIN": "-8.00 dB" },
      "settings": { "mode": "TRACK", "preampDb": 3, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -5.0, "attenuation": 0.5623, "boostDb": 0, "source": "TRACK" } },
    { "name": "untagged files use the untagged preamp", "tags": { "TITLE": "x" },
      "settings": { "mode": "TRACK", "preampDb": 3, "untaggedPreampDb": -6, "preventClipping": true },
      "expect": { "totalDb": -6.0, "attenuation": 0.5012, "boostDb": 0, "source": "UNTAGGED" } },
    { "name": "Opus R128 gain converts to the -18 LUFS reference", "tags": { "R128_TRACK_GAIN": "-2816" },
      "settings": { "mode": "TRACK", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -6.0, "attenuation": 0.5012, "boostDb": 0, "source": "TRACK" } },
    { "name": "comma decimal separator", "tags": { "REPLAYGAIN_TRACK_GAIN": "-6,50 dB" },
      "settings": { "mode": "TRACK", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": -6.5, "attenuation": 0.4732, "boostDb": 0, "source": "TRACK" } },
    { "name": "off", "tags": { "REPLAYGAIN_TRACK_GAIN": "-6.48 dB" },
      "settings": { "mode": "OFF", "preampDb": 0, "untaggedPreampDb": 0, "preventClipping": true },
      "expect": { "totalDb": 0, "attenuation": 1.0, "boostDb": 0, "source": "OFF" } }
  ]
}
